OLE_HTTP_PORT=:8080
# Comma-separated literal proxy IPs/CIDRs; empty ignores X-Forwarded-For.
# Example for a local reverse proxy: 127.0.0.1/32,::1/128
OLE_HTTP_TRUSTED_PROXIES=
OLE_STUN_LISTEN_ADDR=:3478
OLE_RELAY_LISTEN_ADDR=:3479
OLE_RELAY_QUOTA_WINDOW=
OLE_RELAY_QUOTA_PACKETS=0
OLE_RELAY_QUOTA_BYTES=0
OLE_RELAY_ABUSE_WINDOW=1m
OLE_RELAY_ABUSE_THRESHOLD=3
OLE_RELAY_ABUSE_BLOCK_DURATION=5m
OLE_AGENT_ADDR=127.0.0.1:5858
OLE_AGENT_STUN_SERVER_ADDR=
# Comma-separated relay pool is supported, for example: 127.0.0.1:3479,127.0.0.1:3480
OLE_AGENT_RELAY_SERVER_ADDR=
OLE_AGENT_RELAY_FAILBACK_PERIOD=30s
OLE_AGENT_TRANSPORT_KEEPALIVE=20s
OLE_AGENT_TRANSPORT_LOSS_LIMIT=3
OLE_AGENT_RECONNECT_RETRY_BASE=1s
OLE_AGENT_RECONNECT_RETRY_MAX=1m
OLE_UPDATE_CHANNEL=stable
OLE_UPDATE_MANIFEST_URL=
OLE_UPDATE_STABLE_MANIFEST_URL=
OLE_UPDATE_BETA_MANIFEST_URL=
OLE_UPDATE_CHECK_PERIOD=6h
OLE_UPDATE_DOWNLOAD_DIR=
OLE_AGENT_DNS_LISTEN_ADDR=127.0.0.1:53
OLE_AGENT_DNS_DOMAIN=ole
OLE_PEER_HEARTBEAT_TTL=2m
OLE_AGENT_STUN_PROBE_PERIOD=60s
OLE_AGENT_DIRECT_PROBE_TIMEOUT=300ms
OLE_AGENT_DIRECT_RETRY_BASE=1s
OLE_AGENT_DIRECT_RETRY_MAX=30s
OLE_AGENT_DIRECT_MAX_ATTEMPTS=5
OLE_AGENT_STATE_PATH=
OLE_GUI_LOCALE=
OLE_WINTUN_ENABLED=auto
OLE_WINTUN_DLL_PATH=
OLE_ADAPTER_NAME=Ole
OLE_CLEANUP_INTERVAL=5m
OLE_AUTO_MIGRATE=true
OLE_MIGRATIONS_DIR=internal/store/postgres/migrations
# Required for the server: generate a random secret with at least 32 bytes.
# See docs/env.md. cmd/migrate does not require this setting.
OLE_JWT_SECRET=
OLE_JWT_ISSUER=ole-server
OLE_SERVER_VERSION=0.1.0
OLE_MIN_CLIENT_VERSION=0.1.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

POSTGRES_DB=ole
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

OLE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ole?sslmode=disable
